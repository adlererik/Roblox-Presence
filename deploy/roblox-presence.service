[Unit]
Description=Roblox Presence Monitor
Documentation=file:/opt/roblox-presence/current/README.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
DynamicUser=yes
WorkingDirectory=/opt/roblox-presence/current
ExecStart=/usr/bin/python3 -B -m roblox_presence --config /etc/roblox-presence/config.json run
Environment=PYTHONUNBUFFERED=1
LoadCredential=roblox_cookie:/etc/roblox-presence/roblox_cookie
LoadCredential=ntfy_topic:/etc/roblox-presence/ntfy_topic
StateDirectory=roblox-presence
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=15s
WatchdogSec=90s
NotifyAccess=main
TimeoutStartSec=30s
TimeoutStopSec=45s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SocketBindDeny=any
CPUQuota=5%
MemoryMax=128M
TasksMax=16
Nice=10
IOSchedulingClass=idle
LimitCORE=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=roblox-presence

[Install]
WantedBy=multi-user.target
